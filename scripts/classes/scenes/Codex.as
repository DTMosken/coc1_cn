      public function setFlags() : void
      {
         if(get_player().hasSpells() && FlagDict_Impl_.arrayReadInt(KFLAGS.flags,2047) <= 0)
         {
            FlagDict_Impl_.arrayWriteInt(KFLAGS.flags,2047,1);
         }
         if(FlagDict_Impl_.arrayReadInt(KFLAGS.flags,463) > 0)
         {
            FlagDict_Impl_.arrayWriteInt(KFLAGS.flags,2045,1);
         }
         if(FlagDict_Impl_.arrayReadInt(KFLAGS.flags,410) > 0 || FlagDict_Impl_.arrayReadInt(KFLAGS.flags,407) >= 3)
         {
            FlagDict_Impl_.arrayWriteInt(KFLAGS.flags,2050,1);
         }
      }
      
