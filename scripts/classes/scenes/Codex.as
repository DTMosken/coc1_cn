      public function codexMenu(param1:String) : void
      {
         var _loc4_:* = null;
         var _loc5_:* = null;
         var _loc6_:int = 0;
         var _loc7_:* = null;
         var _loc2_:int = get_buttons().page;
         var _loc3_:Array = [];
         _loc4_ = new MapKeyValueIterator(allEntries);
         while(Boolean(_loc4_.hasNext()))
         {
            _loc5_ = _loc4_.next();
            _loc6_ = int(_loc5_.key);
            _loc7_ = _loc5_.value;
            if(_loc7_.type == param1)
            {
               _loc3_.push({
                  "key":_loc6_,
                  "value":_loc7_.name
               });
            }
         }
         _loc3_.sort(function(param1:Object, param2:Object):int
         {
            return Reflect.compare(param1.value.toLowerCase(),param2.value.toLowerCase());
         });
         menu();
         _loc6_ = 0;
         while(_loc6_ < int(_loc3_.length))
         {
            _loc4_ = _loc3_[_loc6_];
            _loc6_++;
            addCodexButton(int(_loc4_.key));
         }
         setExitButton("返回",accessCodexMenu,14,false,_loc2_);
      }
      
      public function codexEntryZebras() : void
      {
         headerMain("斑马人");
         outputText("<b>性别：</b> 男，女\n");
         outputText("<b>身高：</b> 5英尺5英寸到6英尺\n");
         outputText("<b>体型：</b> 苗条/修长\n");
         outputText("<b>皮肤：</b> 斑马纹\n");
         outputText("<b>毛发：</b> 斑马纹，带有莫霍克风格的鬃毛\n");
         outputText("<b>眼睛：</b> 棕色到黑色\n");
         outputText("<b>饮食：</b> 食草动物，以草为主，但草药和灌木也是其饮食的一部分\n");
         headerSub("外貌");
         if(get_noFur())
         {
            outputText("大部分是人类，除了以蹄子结尾的趾行腿、覆盖小腿和前臂的条纹皮毛，以及一条末端有一簇毛的长尾巴。代替头发的是一种类似莫霍克的毛发鬃毛，从发际线一直延伸到背部中间。");
         }
         else
         {
            outputText("头部和脸部类似于斑马，但鼻子较短。鬃毛看起来像莫霍克，从发际线开始延伸到背部中间。腿是趾行的，以蹄子结尾。长尾巴末端有一簇毛。上半身是人类（手臂、手、手指、乳房）。");
         }
         headerSub("繁殖");
         outputText("典型的繁殖方式。种马对所有女性都给予关注。当小马驹出生时，它将获得与其母亲相同的地位。");
         headerSub("社会结构");
         outputText("斑马是一夫多妻制的，一匹种马与几匹母马和年幼的后代组成一个后宫。在建立后宫之前，雄性处于单身群体中，雌性则处于仅由雌性组成的出生后宫中，直到被带入种马的后宫。\n");
         outputText("后宫中母马的地位取决于她们被带入后宫的顺序。当一匹新母马被带入后宫时，其他成员会轻视她，让她知道自己的地位在最底层。\n");
         outputText("公马将新母马纳入后宫的第一步是让母马受孕。\n");
         outputText("在大多数情况下，公马都是被动的，除非是在对付那些试图夺走公马部分或全部后宫的人，或者是在为了给后宫添新母马而发生冲突时。当然，还有其他原因。");
         headerSub("天敌");
         outputText("斑马人在靠近狮子人时会表现出极大的焦虑，因为几千年来，他们一直是狮子人的猎物。");
      }
      
      public function codexEntryTerrestrialFire() : void
      {
         headerMain("大地之火");
         outputText("这个魔法学派是由人类巫师阿克巴尔在几十年前创造的。控制它需要付出沉重的代价，但一旦掌握，它就非常强大。核心由火和土组成，分别对应精神和肉体。这在翡翠火息中表现得最为典型：在你的身体核心提取强大的精神能量。随着阿克巴尔在恶魔转化后傲慢和自负的膨胀，他训练了他的心灵魔法，以便将选定的记忆传递给那些同意崇拜他的人。这导致了精神上的脆弱性，不可避免地成为他奥术知识被彻底窃取并重新赠予英格纳姆勇者的漏洞。");
         headerSub("土");
         outputText("土的力量是肉体的力量。身体素质和体质是最高水平施法的理想选择。虽然不常见，但这种魔法媒介以前曾被各种流派多次使用。它粗糙、困难，通常移动大量岩石所需的力量可以更好地用作原始动能伤害或仅仅是火。尽管如此，大地之火是这种媒介找到一席之地的利基市场。与强健身体的共鸣对于正确执行此类法术至关重要。");
         headerSub("火");
         outputText("火的力量是精神的力量。精神毅力和专注力是最高水平施法的理想选择。永远是经典和传统的魔法媒介。火是将原始魔法快速有效地转化为破坏性能量的过程。它不稳定且有效，非常适合新手和熟练的交战法师。大地之火也不例外，它在火焰中看到了功效。专注的心灵和守纪律的精神将用它做出令人难以置信的事情。");
      }
      
      public function codexEntrySuccubus() : void
      {
         headerMain("魅魔");
         outputText("<b>性别：</b> 仅限女性。\n");
         outputText("<b>身高：</b> 不定\n");
         outputText("<b>头发：</b> 不定\n");
         outputText("<b>眼睛：</b> 不定\n");
         headerSub("外貌");
         outputText("魅魔总是以迷人且通常很淫荡的女性形象出现，但她们会根据当前情况修改自己的着装风格，以符合人类女性的期望。在她们的真实形态中，她们通常至少有一对角，随着年龄的增长，这些角会变得更大更长。一些魅魔有第二和第三排角，向后弯曲覆盖在她们的头骨上。她们的皮肤总是完美无瑕，牙齿洁白。在她们的真实形态中，她们的皮肤颜色从蓝色到紫色，很少有午夜黑。");
         headerSub("性器官");
         outputText("魅魔拥有可以被称为“完美阴道”的器官。虽然它看起来很紧，但它有能力伸展到远远超出这么小一块肉应该可能的程度。这确保了无论魅魔伴侣有多大或多小，他们都能进入她并获得足够的摩擦力。阴道表面具有高度的可塑性，魅魔通常会在其内壁添加有纹理的环或蠕动的纤毛，以驱使她们的受害者达到更高的快感。");
         headerSub("繁殖");
         outputText("魅魔不繁殖，相反，当一个凡人女性沉醉于欲望和快感，以至于除了追求快感和美丽的能力之外，她不再关心任何事情时，她们就会被创造出来。母魅魔会使她的受害者陷入欲望的狂热中，直到毫无戒心的受害者字面上射出她的灵魂，并用腐化填补她内心的空虚。值得注意的是，魅魔也可以对男性这样做，创造出一个男魅魔。");
         headerSub("社会结构");
         outputText("魅魔和梦魔在恶魔的社会结构中处于倒数第二的阶层，仅在小恶魔之上。当他们不“饥饿”时，往往容易变得懒惰，通常除了指挥几个小恶魔外，不会被赋予更多的权力。");
         headerSub("特殊属性");
         outputText("直接从源头饮用的魅魔之乳是一种极其强效的催情剂。如果将其储存起来，其催情效果会迅速减弱，而其突变特性则会迅速增强。一些更强大的魅魔能够将她们的乳汁与黑魔法结合使用，从而对她们的伴侣产生改变。");
         headerSub("进食");
         outputText("像大多数恶魔一样，魅魔通过腐化他人来获取力量，并且需要稳定的性液供应才能生存。在极少数情况下，如果魅魔被剥夺“食物”太久，她可能会发现自己虚弱到无法引诱伴侣，从而为了获取食物而达成一项不太有利的协议。令人惊讶的是，大多数魅魔在“吃饱”后都会遵守这样的协议。");
      }
      
      public function codexEntrySpiders() : void
      {
         headerMain("阿剌克涅、蜘蛛变形者和蛛化精灵");
         outputText("<b>性别：</b> 雌性、雄性和扶她\n");
         outputText("<b>皮肤：</b> 所有种类的蜘蛛亲属在没有甲壳覆盖的地方通常都有非常苍白的“皮肤”。极少数个体出生时皮肤很黑，几乎是黑色的，但总的来说，它们的人类部分非常白。\n");
         outputText("<b>头发：</b> 通常是红色、黑色、橙色或绿色。很少有棕色。\n");
         outputText("<b>眼睛：</b> 纯黄色、红色、黑色或紫色，中间有黑色的小瞳孔。所有蜘蛛亲属都有机会拥有四只或六只这样的眼睛。通常多余的眼睛位于额头上，在主眼对的上方，并且小得多。\n");
         outputText("<b>面部特征：</b>大部分与人类相似。所有蜘蛛眷族都有长而像针一样可伸缩的犬齿，可用于注射毒液或吸血。与普通蜘蛛不同，蜘蛛眷族能够靠杂食生存，但只要有可能，他们就喜欢以“蜘蛛的方式”进食。\n");
         outputText("<b>腿部：</b>除了蛛化精灵外，所有蜘蛛眷族都有类似人类的腿和脚。然而，与人类不同的是，蜘蛛眷族的脚只有几个脚趾，可以钩在一起，以便在蜘蛛网上抓握和攀爬。蛛化精灵的下半身完全像蜘蛛。他们有八条蜘蛛腿，用于攀爬蜘蛛网或墙壁，并且腹部比其他蜘蛛种族大得多。\n");
         headerSub("身体结构");
         outputText("阿剌克涅和蜘蛛人与其他两足动物的共同点最多。他们的手部结构与人类完全相同，只是有可能被外骨骼包裹。有些蜘蛛眷族天生就有四只手臂，不过似乎只有“纯种”才会表现出这种特征。所有阿剌克涅和蜘蛛人都有一个类似蛛形纲动物的腹部，从他们的背部，就在臀部上方长出来，不过在不被注意的时候，它往往会垂得很低。在蛛化精灵身上，肛门和相应的“臀部”位于他们蜘蛛半身开始的上方。虽然这种肛门位置差异的原因尚不清楚，但这确实允许蛛化精灵将他们的蜘蛛部分平折在他们众多的腿之间，并允许他们以传统的方式被肛交。");
         headerSub("毒液");
         outputText("所有蜘蛛眷族都有催情毒液。蛛化精灵和阿剌克涅也都有可以使用的麻痹毒素。");
         headerSub("蛛网");
