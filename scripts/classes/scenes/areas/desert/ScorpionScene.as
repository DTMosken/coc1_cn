      public function reset() : void
      {
         saveContent.state = 0;
         saveContent.fate = 0;
         saveContent.talked = false;
      }
      
      public function onAscend(param1:Boolean) : void
      {
         reset();
      }
      
      public function never() : void
      {
         clearOutput();
         outputText("探索这里没有任何价值——这一点，你很确定。你爬上周围的沙丘，下定决心永远不再回到这里，当你到达山顶，栖息在沙海中的这股潮汐波上时，你最后看了一眼那五座石碑，它们静静地躺在那里，孤独地废弃着，然后你转过身，永远地离开了这个地方。");
