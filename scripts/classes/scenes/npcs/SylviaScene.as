      public function get_dolores() : DoloresScene
      {
         return get_game().mothCave.doloresScene;
      }
      
      public function get_debugName() : String
      {
         return "西尔维娅";
      }
      
      public function get_debugHint() : String
      {
         return "";
      }
      
      public function execEncounter() : void
      {
         if(get_sylviaProg() == 0)
         {
            sylviaFirstMeeting();
         }
         else if(get_sylviaProg() == 1)
         {
            sylviaSecondMeeting();
         }
         else if(get_sylviaProg() == 2 && get_sylviaGetAff() > 50)
         {
            sylviaStalking();
         }
         else if(get_sylviaProg() == 3 && 4 > saveContent.sylviaStalking && saveContent.sylviaStalking > 0)
         {
            sylviaStalkAgain();
         }
         else if(get_sylviaProg() == 4 && saveContent.sylviaCapstoneCounter == 3)
         {
            if(get_sylviaGetDom() < 50)
            {
               sylviaSubCapstone();
            }
            else
            {
               sylviaDomCapstone();
            }
         }
         else
         {
            sylviaMenu(true);
         }
      }
      
      public function encounterName() : String
      {
         return "西尔维娅";
      }
      
      public function encounterChance() : Number
      {
         if(get_sylviaProg() == -1 || get_sylviaProg() >= 4 || get_player().level < 18 && get_time().days < 108 || saveContent.encounterDisabled == get_time().get_totalTime())
         {
            return 0;
         }
         return 1;
      }
      
